package(default_visibility = ["//visibility:public"])

# Constraint propio para distinguir, dentro de linux_x86_64, que compilador
# debe resolver Bazel: gcc o clang. Sin esto, dos toolchain() con el mismo
# exec/target_compatible_with serian ambiguos para la resolucion de toolchains.
constraint_setting(name = "compiler")

constraint_value(
    name = "gcc",
    constraint_setting = ":compiler",
)

constraint_value(
    name = "clang",
    constraint_setting = ":compiler",
)

platform(
    name = "linux_x86_64_gcc",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
        ":gcc",
    ],
)

platform(
    name = "linux_x86_64_clang",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
        ":clang",
    ],
)
